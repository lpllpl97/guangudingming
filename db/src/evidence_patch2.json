 "new_texts": [
  {
   "text_id": "T002-120",
   "classic_id": "J007",
   "chapter": "小雅·巷伯",
   "content": "骄人好好，劳人草草。苍天苍天，视彼骄人，矜此劳人。",
   "paraphrase": "《诗经·小雅·巷伯》篇句，篇中亦见“投畀有昊”之语。",
   "naming_point": "“昊”为广大的天，取开阔广大之象。",
   "evidence_code": "A",
   "source_note": "《诗经·小雅·巷伯》"
  },
  {
   "text_id": "T002-121",
   "classic_id": "J007",
   "chapter": "陈风·月出",
   "content": "月出皎兮，佼人僚兮。",
   "paraphrase": "月亮出来多么洁白明亮。",
   "naming_point": "“皎”为洁白明净，取月色清朗之象。",
   "evidence_code": "A",
   "source_note": "《诗经·陈风·月出》"
  },
  {
   "text_id": "T002-122",
   "classic_id": "J007",
   "chapter": "卫风·淇奥",
   "content": "有匪君子，如切如磋，如琢如磨。",
   "paraphrase": "君子修德如加工玉石，切磋琢磨。",
   "naming_point": "“琢”“磨”取砥砺精进之义。",
   "evidence_code": "A",
   "source_note": "《诗经·卫风·淇奥》"
  },
  {
   "text_id": "T002-123",
   "classic_id": "J007",
   "chapter": "小雅·鹿鸣",
   "content": "呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。",
   "paraphrase": "鹿鸣相呼，宴饮嘉宾时鼓瑟吹笙。",
   "naming_point": "“瑟”“笙”“鼓”为雅乐之器，取和乐之义。",
   "evidence_code": "A",
   "source_note": "《诗经·小雅·鹿鸣》"
  },
  {
   "text_id": "T002-124",
   "classic_id": "J007",
   "chapter": "周南·关雎",
   "content": "窈窕淑女，琴瑟友之。",
   "paraphrase": "以琴瑟与淑女相和。",
   "naming_point": "“琴”“瑟”为雅乐之器，取和乐自持之义。",
   "evidence_code": "A",
   "source_note": "《诗经·周南·关雎》"
  },
  {
   "text_id": "T002-125",
   "classic_id": "J007",
   "chapter": "卫风·木瓜",
   "content": "投我以木瓜，报之以琼琚。",
   "paraphrase": "以美玉回报赠物，取其厚报之义。",
   "naming_point": "“琼”“琚”为佩玉，借玉取美好守礼之义。",
   "evidence_code": "A",
   "source_note": "《诗经·卫风·木瓜》"
  },
  {
   "text_id": "T002-126",
   "classic_id": "J007",
   "chapter": "大雅·泮水",
   "content": "憬彼淮夷，来献其琛。",
   "paraphrase": "淮夷来献珍宝。",
   "naming_point": "“琛”为珍宝，借物取珍贵之义。",
   "evidence_code": "A",
   "source_note": "《诗经·大雅·泮水》"
  },
  {
   "text_id": "T002-127",
   "classic_id": "J007",
   "chapter": "小雅·斯干",
   "content": "乃生男子，载寝之床，载衣之裳，载弄之璋。",
   "paraphrase": "生男则让他玩玉璋。",
   "naming_point": "“璋”为礼器玉璋，借取贵重成器之义。",
   "evidence_code": "A",
   "source_note": "《诗经·小雅·斯干》"
  },
  {
   "text_id": "T002-128",
   "classic_id": "J007",
   "chapter": "鄘风·载驰",
   "content": "我行其野，芃芃其麦。",
   "paraphrase": "我行走在田野，麦子长得茂盛。",
   "naming_point": "“芃”为草木茂盛，取生机繁盛之象。",
   "evidence_code": "A",
   "source_note": "《诗经·鄘风·载驰》"
  },
  {
   "text_id": "T002-129",
   "classic_id": "J007",
   "chapter": "大雅·烝民",
   "content": "天生烝民，有物有则。民之秉彝，好是懿德。",
   "paraphrase": "天生众民，有其常道；民心守常，喜好美德。",
   "naming_point": "“懿”为美善之德，“彝”为常道，取守常向善之义。",
   "evidence_code": "A",
   "source_note": "《诗经·大雅·烝民》"
  },
  {
   "text_id": "T002-130",
   "classic_id": "J009",
   "chapter": "离骚",
   "content": "荃不察余之中情兮，反信谗而齌怒。",
   "paraphrase": "荃（香草，喻君）不能体察我内心的真情。",
   "naming_point": "“荃”为香草，取芳香修洁之象。",
   "evidence_code": "A",
   "source_note": "《楚辞·离骚》"
  },
  {
   "text_id": "T002-131",
   "classic_id": "J009",
   "chapter": "九歌·湘夫人",
   "content": "沅有芷兮澧有兰，思公子兮未敢言。",
   "paraphrase": "沅水有芷草，澧水有兰草。",
   "naming_point": "“沅”“兰”“芷”同出此句，为香草水泽之象。",
   "evidence_code": "A",
   "source_note": "《楚辞·九歌·湘夫人》"
  }
 ],
