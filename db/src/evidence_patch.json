 "new_texts": [
  {
   "text_id": "T002-101",
   "classic_id": "J007",
   "chapter": "小雅·车舝",
   "content": "高山仰止，景行行止。",
   "paraphrase": "高山为人所仰望，大道为人所遵循。",
   "naming_point": "景行：光明正大的行为与可效法的大道；'景'取光明、景仰之义。",
   "evidence_code": "A",
   "source_note": "《诗经·小雅·车舝》"
  },
  {
   "text_id": "T002-102",
   "classic_id": "J006",
   "chapter": "季氏",
   "content": "不学诗，无以言。",
   "paraphrase": "不学习《诗》，便没有得体的言辞。",
   "naming_point": "学为立言进德之基。",
   "evidence_code": "A",
   "source_note": "《论语·季氏》"
  },
  {
   "text_id": "T002-103",
   "classic_id": "J006",
   "chapter": "雍也",
   "content": "文质彬彬，然后君子。",
   "paraphrase": "文采与质朴配合适宜，才成为君子。",
   "naming_point": "文与质相济，'文'为文德文采之义。",
   "evidence_code": "A",
   "source_note": "《论语·雍也》"
  },
  {
   "text_id": "T002-104",
   "classic_id": "J006",
   "chapter": "为政",
   "content": "学而不思则罔，思而不学则殆。",
   "paraphrase": "只学不思考会迷惘，只思考不学习会危殆。",
   "naming_point": "学与思并重，'思'为审思明辨之义。",
   "evidence_code": "A",
   "source_note": "《论语·为政》"
  },
  {
   "text_id": "T002-105",
   "classic_id": "J001",
   "chapter": "谦·彖传",
   "content": "谦亨，天道下济而光明。",
   "paraphrase": "谦道亨通，天道下施而光明。",
   "naming_point": "谦为《周易》一卦之德，取谦抑自守、光明下济之义。",
   "evidence_code": "A",
   "source_note": "《周易·谦·彖传》"
  },
  {
   "text_id": "T002-106",
   "classic_id": "J001",
   "chapter": "恒·彖传",
   "content": "天地之道，恒久而不已也。",
   "paraphrase": "天地运行之道，恒久而不停息。",
   "naming_point": "恒取恒久守常之义，出自《周易·恒》。",
   "evidence_code": "A",
   "source_note": "《周易·恒·彖传》"
  },
  {
   "text_id": "T002-107",
   "classic_id": "J010",
   "chapter": "公孙丑上",
   "content": "我善养吾浩然之气。",
   "paraphrase": "我善于培养自己正大充沛的浩然之气。",
   "naming_point": "浩然之气取正大、充沛、光明之义。",
   "evidence_code": "A",
   "source_note": "《孟子·公孙丑上》"
  },
  {
   "text_id": "T002-108",
   "classic_id": "J006",
   "chapter": "雍也",
   "content": "君子博学于文，约之以礼。",
   "paraphrase": "君子广泛学习文献，并以礼约束自己。",
   "naming_point": "'文'为文德文采之义，可与'博学'相承。",
   "evidence_code": "A",
   "source_note": "《论语·雍也》"
  },
  {
   "text_id": "T002-109",
   "classic_id": "J006",
   "chapter": "学而",
   "content": "夫子温良恭俭让以得之。",
   "paraphrase": "夫子靠温和、善良、恭敬、俭朴、谦让而得到。",
   "naming_point": "'温''恭'同出此句，为传统德性用字的直接出处。",
   "evidence_code": "A",
   "source_note": "《论语·学而》"
  },
  {
   "text_id": "T002-110",
   "classic_id": "J003",
   "chapter": "中庸",
   "content": "诚者，天之道也；诚之者，人之道也。",
   "paraphrase": "诚是天之道，追求诚是人之道。",
   "naming_point": "'诚'取真实无妄、立身守信之义。",
   "evidence_code": "A",
   "source_note": "《中庸》"
  },
  {
   "text_id": "T002-111",
   "classic_id": "J003",
   "chapter": "中庸",
   "content": "莫见乎隐，莫显乎微，故君子慎其独也。",
   "paraphrase": "没有比隐微之处更容易显现的，所以君子在独处时也谨慎。",
   "naming_point": "'慎'取谨慎自律、慎独之义。",
   "evidence_code": "A",
   "source_note": "《中庸》"
  },
  {
   "text_id": "T002-112",
   "classic_id": "J006",
   "chapter": "颜渊",
   "content": "非礼勿视，非礼勿听，非礼勿言，非礼勿动。",
   "paraphrase": "不合于礼的不看、不听、不说、不做。",
   "naming_point": "'礼'取礼制敬意、自我约束之义。",
   "evidence_code": "A",
   "source_note": "《论语·颜渊》"
  },
  {
   "text_id": "T002-113",
   "classic_id": "J006",
   "chapter": "季氏",
   "content": "不学礼，无以立。",
   "paraphrase": "不学习礼，就无法立身。",
   "naming_point": "'礼'为立身之基，与'不学诗，无以言'并出《论语·季氏》。",
   "evidence_code": "A",
   "source_note": "《论语·季氏》"
  },
  {
   "text_id": "T002-114",
   "classic_id": "J006",
   "chapter": "里仁",
   "content": "君子欲讷于言而敏于行。",
   "paraphrase": "君子说话谨慎而行动敏捷。",
   "naming_point": "'行'取践行务实之义。",
   "evidence_code": "A",
   "source_note": "《论语·里仁》"
  },
  {
   "text_id": "T002-115",
   "classic_id": "J006",
   "chapter": "学而",
   "content": "敬事而信，节用而爱人。",
   "paraphrase": "严肃认真地对待工作，讲究信用，节约用度，爱护他人。",
   "naming_point": "'敬'取敬慎事上之义。",
   "evidence_code": "A",
   "source_note": "《论语·学而》"
  },
  {
   "text_id": "T002-116",
   "classic_id": "J004",
   "chapter": "曲礼上",
   "content": "毋不敬，俨若思，安定辞。",
   "paraphrase": "一切以敬为本，神态庄重如有所思，说话安详确定。",
   "naming_point": "'敬'为《礼记》所重之德，取敬慎端庄之义。",
   "evidence_code": "A",
   "source_note": "《礼记·曲礼上》"
  },
  {
   "text_id": "T002-117",
   "classic_id": "J006",
   "chapter": "颜渊",
   "content": "君子敬而无失，与人恭而有礼。",
   "paraphrase": "君子严肃认真而无过失，待人恭敬而合于礼。",
   "naming_point": "'敬'与'恭'并举，取敬慎、谦恭之义。",
   "evidence_code": "A",
   "source_note": "《论语·颜渊》"
  }
 ],
